# Runtime-only configuration. Cài thành /etc/hb/teleop.env; không sync file thật.

# Interface DDS của robot. Phải khớp với high_level_2.
UNITREE_NETWORK_INTERFACE=eth10

# Địa chỉ host chạy Quest bridge, dùng cho URL HTTPS hiện trên headset.
HB_TELEOP_HOST_IP=10.42.0.1

# Chứng chỉ HTTPS có SAN khớp HB_TELEOP_HOST_IP. Giữ private key ngoài git.
HB_TELEOP_CERT_FILE=/etc/hb/teleop/cert.pem
HB_TELEOP_KEY_FILE=/etc/hb/teleop/key.pem

# Tần số vòng điều khiển. Bằng chứng mô phỏng hiện tại đạt ~10-20 Hz;
# đặt cao hơn mà không đo lại là không có căn cứ.
HB_TELEOP_CONTROL_HZ=20

# Cổng an toàn. Để 0 cho tới khi docs/hardware_gate.md được đóng đủ.
# 1 = cho phép ghi joint target xuống motor. Không đặt 1 khi chưa có người giữ E-stop.
HB_TELEOP_ALLOW_MOTOR_WRITE=0
