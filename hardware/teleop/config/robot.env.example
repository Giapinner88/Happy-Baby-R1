# Địa chỉ robot RIÊNG của từng máy.
#
# KHÔNG để file thật bên trong thư mục HB: khi copy folder giữa máy dev và máy
# trạm nó sẽ bị đem theo và ghi đè -> sai địa chỉ. Hãy copy ra NGOÀI folder:
#
#   mkdir -p ~/.config/hb
#   cp teleop/config/robot.env.example ~/.config/hb/robot.env
#   # rồi sửa dòng ROBOT cho đúng máy này
#
# Muốn trỏ sang vị trí khác: đặt biến HB_ROBOT_CONF=/duong/dan/khac.
#
# Dùng chung file với r1_integration: chỉ cần một bản ~/.config/hb/robot.env.

ROBOT=unitree@10.42.0.33
