<mujoco model="r1 mixed terrain course">
  <compiler angle="radian" meshdir="assets"/>
  <include file="unitree_r1/xmls/r1.xml"/>

  <statistic center="1.5 0 0.8" extent="11"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="-130" elevation="-25"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0"
             width="512" height="3072"/>
    <texture type="2d" name="mixed_floor_checker" builtin="checker" mark="edge"
             rgb1="0.20 0.28 0.36" rgb2="0.10 0.15 0.22"
             markrgb="0.75 0.75 0.75" width="300" height="300"/>
    <material name="mixed_floor" texture="mixed_floor_checker" texuniform="true"
              texrepeat="24 18" reflectance="0.08"/>
    <material name="slope_5_material" rgba="0.20 0.55 0.25 1"/>
    <material name="slope_15_material" rgba="0.72 0.55 0.12 1"/>
    <material name="slope_30_material" rgba="0.70 0.22 0.12 1"/>
    <material name="stairs_5_material" rgba="0.20 0.50 0.75 1"/>
    <material name="stairs_10_material" rgba="0.42 0.28 0.72 1"/>
    <material name="rough_material" rgba="0.36 0.24 0.12 1"/>
    <material name="obstacle_material" rgba="0.85 0.35 0.08 1"/>
  </asset>

  <default>
    <geom friction="0.9 0.005 0.0001" solimp="0.9 0.95 0.001" solref="0.002 1"/>
    <default class="mixed_terrain">
      <!-- group 0 is visible to the RoughController 187-point height scan. -->
      <geom priority="1" condim="3" group="0"
            friction="1.0 0.005 0.0001"/>
    </default>
  </default>

  <worldbody>
    <light pos="0 0 6" dir="0 0 -1" directional="true"/>

    <!-- Wide flat reference floor. The central 4x4 m area is obstacle-free. -->
    <geom name="mixed_floor" class="mixed_terrain" type="plane" size="12 9 0.05"
          material="mixed_floor"/>

    <!--
      Three independent +X lanes. Each inclined surface is 3 m long, followed
      by a 1 m plateau and a 3 m descent back to z=0.
    -->
    <geom name="slope_5_up" class="mixed_terrain" type="box"
          pos="4.498649834 3 0.080923879" size="1.5 0.8 0.05"
          quat="0.9990482216 0 -0.0436193874 0" material="slope_5_material"/>
    <geom name="slope_5_plateau" class="mixed_terrain" type="box"
          pos="6.488584094 3 0.130733614" size="0.5 0.8 0.130733614"
          material="slope_5_material"/>
    <geom name="slope_5_down" class="mixed_terrain" type="box"
          pos="8.478518354 3 0.080923879" size="1.5 0.8 0.05"
          quat="0.9990482216 0 0.0436193874 0" material="slope_5_material"/>

    <geom name="slope_15_up" class="mixed_terrain" type="box"
