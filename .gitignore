# ROS 2 / Colcon build artifacts
build/
install/
log/
.colcon/
**/build/
**/cmake-build-*/
**/out/

# Vendored third-party dependencies
third_party/

# CMake / Make artifacts
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
compile_commands.json
CTestConfiguration.ini
CTestCustom.cmake
CTestTestfile.cmake
Makefile
install_manifest.txt
symlink_install_manifest.txt

# Python cache and virtual environments
__pycache__/
*.py[cod]
*$py.class
.ipynb_checkpoints/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
.venv/
venv/
env/

# Local environment / secrets
.env
.env.*
*.local

# IDE / Editor settings
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/

# OS generated files
.DS_Store
Thumbs.db

# Archives / temporary files
*.zip
*.tar
*.tar.gz
*.tgz
*.tmp
*.swp
*.swo

# Runtime logs and dumps
*.log
*.out
*.err
*.pid
*.pid.lock

# ROS bag and recording artifacts
*.bag
*.bag.active
*.db3
*.mcap
*.zst

# Large local data (ignore contents, keep folder with .gitkeep)
data/datasets/*
data/models/*
data/processed/*
data/rosbags/*
data/sim_state_logs/*
media/videos/*

# Keep placeholder files inside ignored data dirs
!data/datasets/.gitkeep
!data/models/.gitkeep
!data/processed/.gitkeep
!data/rosbags/.gitkeep
!data/sim_state_logs/.gitkeep
!media/videos/.gitkeep
