# Build output (rebuilt on the robot by `make build`)
build/
**/build/
**/build_*/
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
compile_commands.json
CTestTestfile.cmake
Testing/

# Vendor code is ignored by default; teleop's pinned vendor tree is required at runtime
third_party/
!teleop/third_party/

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.venv/

# Runtime output on the robot
**/logs/
teleop/results/
controller/motions/raw/
*.log

# Secrets and machine-local settings (real values live in /etc/hb on the robot)
.env
.env.*
*.env
!*.env.example
*.local

# Editors / OS / archives
.vscode/
.idea/
.DS_Store
*.swp
*.tmp
*.zip
*.tar
*.tar.gz
*.tgz
