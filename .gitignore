# ROS 2 / Colcon build artifacts
build/
install/
log/
.colcon/
**/build/
**/cmake-build-*/
**/out/

# Vendored third-party dependencies
third_party/

# CMake / Make artifacts
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
compile_commands.json
CTestConfiguration.ini
CTestCustom.cmake
CTestTestfile.cmake
Makefile
# ...nhưng Makefile GỐC là entry point của dự án (make teleop), không phải do
# CMake sinh ra. Makefile của CMake nằm trong build/ nên đã bị luật build/ chặn.
!/Makefile
install_manifest.txt
symlink_install_manifest.txt

# Python cache and virtual environments
__pycache__/
*.py[cod]
*$py.class
.ipynb_checkpoints/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
.venv/
venv/
env/

# Local environment / secrets
.env
.env.*
*.local
.agents

# IDE / Editor settings
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/

# OS generated files
.DS_Store
Thumbs.db

# Archives / temporary files
*.zip
*.tar
*.tar.gz
*.tgz
*.tmp
*.swp
*.swo

# Runtime logs and dumps
*.log
*.out
*.err
*.pid
*.pid.lock

# ROS bag and recording artifacts
*.bag
*.bag.active
*.db3
*.mcap
*.zst

# Large local data (ignore contents, keep folder with .gitkeep)
data/datasets/*
data/cache/*
data/models/*
data/policies/*
data/processed/*
data/rosbags/*
data/runs/*
data/sim_state_logs/*
media/videos/*
results/demo/*
results/smoke/*
experiments/**/runs/*
experiments/**/artifacts/*

# Ảnh chụp pháp chứng kéo từ robot về: giữ trên máy trạm để phân tích, không
# đưa binary ARM64 và bản source đã sync vào lịch sử git.
archive/

# Keep placeholder files inside ignored data dirs
!data/datasets/.gitkeep
!data/cache/.gitkeep
!data/models/.gitkeep
!data/policies/.gitkeep
!data/processed/.gitkeep
!data/rosbags/.gitkeep
!data/runs/.gitkeep
!data/sim_state_logs/.gitkeep
!media/videos/.gitkeep
!data/datasets/README.md
!data/cache/README.md
!data/models/README.md
!data/policies/README.md
!data/processed/README.md
!data/rosbags/README.md
!data/runs/README.md
!data/sim_state_logs/README.md
!data/sim_state_logs/MUJOCO_LOG.txt
!media/videos/README.md
!results/demo/README.md
!results/smoke/README.md
!experiments/**/runs/README.md
!experiments/**/artifacts/README.md
