{
  "schema_version": 1,
  "experiment_id": "M001_flat_stand_walk",
  "title": "R1 MJLab planar stand and slow-walk pilot",
  "framework": "mjlab",
  "task": "Unitree-R1-Flat",
  "environment": "r1_env",
  "r1_mjcf": "assets/mujoco/unitree_robots/r1/R1.xml",
  "training": {
    "num_envs": 1024,
    "max_iterations": 3000,
    "save_interval": 200,
    "seed": 42,
    "run_name": "M001_flat_stand_walk"
  },
  "execution": {
    "cuda_visible_devices": "1"
  },
  "command_distribution": {
    "standing_probability": 0.3,
    "lin_vel_x_mps": [-0.25, 0.25],
    "lin_vel_y_mps": [0.0, 0.0],
    "yaw_rate_radps": [0.0, 0.0],
    "minimum_nonzero_command_norm_mps": 0.1
  },
  "environment_protocol": {
    "terrain": "plane",
    "disable_terrain_curriculum": true,
    "disable_velocity_curriculum": true,
    "disable_interval_pushes": true
  },
  "capture": {
    "record_training_video": true,
    "training_video_length_steps": 250,
    "training_video_interval_steps": 10000,
    "convert_tensorboard_to_csv_and_plots": true,
    "raw_evaluation_trace_required": true,
    "evaluation_video_required": true
  },
  "evaluation_plan": {
    "required_before_promotion": true,
    "standing_command_mps": 0.0,
    "walking_commands_mps": [-0.05, 0.05, -0.1, 0.1],
    "note": "Training uses +/-0.25 m/s because MJLab masks commands at or below norm 0.1; evaluation must separately test the slow targets."
  }
}
