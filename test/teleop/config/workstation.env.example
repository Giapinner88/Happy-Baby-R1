# Cấu hình RIÊNG cho máy chạy Quest bridge. Copy ra ngoài repo:
#   cp config/workstation.env.example ~/.config/hb/teleop.env
# Các phép gán giữ nguyên biến đã export để CLI vẫn có quyền ưu tiên.

HB_TELEOP_HOST_IP="${HB_TELEOP_HOST_IP:-192.168.1.105}"
HB_TELEOP_CERT_FILE="${HB_TELEOP_CERT_FILE:-$HOME/.config/xr_teleoperate/happybaby_192_168_1_105/cert.pem}"
HB_TELEOP_KEY_FILE="${HB_TELEOP_KEY_FILE:-$HOME/.config/xr_teleoperate/happybaby_192_168_1_105/key.pem}"
HB_TELEOP_VUER_ENV="${HB_TELEOP_VUER_ENV:-tv}"
HB_TELEOP_IK_ENV="${HB_TELEOP_IK_ENV:-unitree_sim_env}"
