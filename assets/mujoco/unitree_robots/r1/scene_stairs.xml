<mujoco model="r1 stairs scene">
  <include file="R1.xml"/>

  <statistic center="-0.7 0 0.7" extent="1.8"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.1 0.1 0.1" specular="0.9 0.9 0.9"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="-140" elevation="-20"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="flat" rgb1="0 0 0" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3" markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>
    <material name="stepmat" rgba="0.45 0.48 0.5 1"/>
  </asset>

  <worldbody>
    <light pos="1 0 3.5" dir="0 0 -1" directional="true"/>
    <geom name="floor" size="0 0 0.05" type="plane" material="groundplane" friction="1 1 1"/>
    <site name="world_hang_site" pos="0 0 0.92" size="0.035" rgba="0.2 0.8 1 1"/>

    <geom name="step_1" type="box" pos="-0.35 0 0.035" size="0.18 0.55 0.035" material="stepmat" friction="1 1 1"/>
    <geom name="step_2" type="box" pos="-0.71 0 0.07" size="0.18 0.55 0.07" material="stepmat" friction="1 1 1"/>
    <geom name="step_3" type="box" pos="-1.07 0 0.105" size="0.18 0.55 0.105" material="stepmat" friction="1 1 1"/>
    <geom name="step_4" type="box" pos="-1.43 0 0.14" size="0.18 0.55 0.14" material="stepmat" friction="1 1 1"/>
  </worldbody>

  <equality>
    <connect name="r1_hanging_connect" site1="world_hang_site" site2="pelvis_hang_site" active="true" solref="0.005 1"/>
  </equality>
</mujoco>
