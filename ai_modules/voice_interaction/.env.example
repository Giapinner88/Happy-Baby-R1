OPENAI_API_KEY=sk-your-openai-key-here

# OpenAI Realtime speech-to-speech settings.
OPENAI_REALTIME_MODEL=gpt-realtime
OPENAI_VOICE=echo
OPENAI_TURN_EAGERNESS=medium
OPENAI_INTERRUPT_RESPONSE=0
OPENAI_VOICE_SPEED=1.0

# Optional runner settings.
HOST=0.0.0.0
PORT=7860

# Unitree R1 bridge on PC2. Build and test r1_bridge before starting the bot.
UNITREE_NETWORK_INTERFACE=eth10
UNITREE_BRIDGE_PATH=./unitree_bridge/build/r1_bridge
UNITREE_MIC_ENABLED=1
UNITREE_SPEAKER_ENABLED=1
UNITREE_AUDIO_DEBUG=1
UNITREE_DROP_BROWSER_AUDIO=0
# 0 keeps one continuous multicast receiver instead of restarting it periodically.
UNITREE_MIC_SEGMENT_SECS=0
UNITREE_ACTIONS_ENABLED=0
UNITREE_ACTION_COOLDOWN_SECS=2.0
UNITREE_AUDIO_APP_NAME=pipecat
