# Runtime-only configuration. Install as /etc/hb/stack.env; never sync the real file.
OPENAI_API_KEY=sk-your-openai-key-here

# Bắt buộc khi voice/config/tuning.yaml đặt tts.provider=elevenlabs.
# Không commit giá trị thật. Voice ID phải thuộc cùng workspace với API key.
ELEVENLABS_API_KEY=your-elevenlabs-api-key-here
ELEVENLABS_VOICE_ID=your-elevenlabs-voice-id-here

# Hardware/machine-specific settings. Voice/model/speed/volume and the selected
# mic source are in voice/config/tuning.yaml and are safe to sync from the dev machine.
UNITREE_NETWORK_INTERFACE=eth10

# Mic ngoài cắm vào PC2. ĐỂ TRỐNG ALSA_DEVICE là đúng: runtime tự tìm card USB
# có capture trong /proc/asound/cards mỗi lần khởi động lại bộ thu (5 giây một
# lần), nên đổi mic sang model khác không phải sửa file nào.
# Chỉ đặt khi có TỪ HAI mic USB trở lên và cần ghim đúng một cái; khi đó phải
# dùng tên card ổn định, không dùng chỉ số như hw:1,0 (chỉ số đổi theo thứ tự
# cắm: mic BOYALINK từng chiếm card 0 và đẩy card HDA của Jetson xuống 1).
# ALSA_DEVICE=plughw:CARD=BOYALINK,DEV=0
ALSA_SAMPLE_RATE=48000

# Chỉ dùng các biến dưới khi rollback input.source về r1_multicast (mic PC1).
# UNITREE_MIC_GROUP_IP=239.168.123.161
# UNITREE_MIC_PORT=5555
# UNITREE_MIC_PAYLOAD_MODE=raw
