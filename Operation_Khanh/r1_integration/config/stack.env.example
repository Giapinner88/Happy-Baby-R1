# Runtime-only configuration. Install as /etc/hb/stack.env; never sync the real file.
OPENAI_API_KEY=sk-your-openai-key-here

# Hardware/machine-specific settings. Mic source, voice/model/speed/volume are in
# voice_r1/config/tuning.yaml and are safe to sync from the dev machine.
UNITREE_NETWORK_INTERFACE=eth10

# Future USB mic. Use a stable ALSA/udev card name, never hw:1,0.
ALSA_DEVICE=plughw:CARD=RobotMic,DEV=0
ALSA_SAMPLE_RATE=16000

# Advanced R1 mic overrides; leave unset while the current firmware works.
# UNITREE_MIC_GROUP_IP=239.168.123.161
# UNITREE_MIC_PORT=5555
# UNITREE_MIC_PAYLOAD_MODE=raw
