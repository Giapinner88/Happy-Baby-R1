[Unit]
Description=HB R1 read-only PTT and audio coordinator
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=@RUN_USER@
WorkingDirectory=@HB_ROOT@/r1_integration
Environment=HB_ROOT=@HB_ROOT@
EnvironmentFile=-/etc/hb/stack.env
RuntimeDirectory=hb
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=yes
ExecStartPre=/bin/bash -c 'for i in $(seq 1 60); do ip -4 addr show @INTERFACE@ 2>/dev/null | grep -q "inet " && { sleep 2; exit 0; }; sleep 0.5; done; exit 1'
ExecStartPre=/bin/bash @HB_ROOT@/r1_integration/scripts/preflight.sh integration
ExecStartPre=/usr/bin/rm -f /run/hb/status.env
ExecStart=@HB_ROOT@/r1_integration/build/hb_integration --interface @INTERFACE@
ExecStartPost=/bin/bash -c 'for i in $(seq 1 40); do test -s /run/hb/status.env && exit 0; sleep 0.25; done; exit 1'
Restart=on-failure
RestartSec=3
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/run/hb

[Install]
WantedBy=hb-stack.target
