<mujoco model="r1 obstacles scene">
  <include file="R1.xml"/>

  <statistic center="-0.9 0 0.7" extent="2.0"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.1 0.1 0.1" specular="0.9 0.9 0.9"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="-140" elevation="-20"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="flat" rgb1="0 0 0" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3" markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>
    <material name="obstacle_red" rgba="0.65 0.18 0.16 1"/>
    <material name="obstacle_blue" rgba="0.18 0.28 0.65 1"/>
  </asset>

  <worldbody>
    <light pos="1 0 3.5" dir="0 0 -1" directional="true"/>
    <geom name="floor" size="0 0 0.05" type="plane" material="groundplane" friction="1 1 1"/>
    <site name="world_hang_site" pos="0 0 0.92" size="0.035" rgba="0.2 0.8 1 1"/>

    <geom name="low_bar_left" type="box" pos="-0.35 0.28 0.055" size="0.24 0.045 0.055" material="obstacle_red" friction="1 1 1"/>
    <geom name="low_bar_right" type="box" pos="-0.35 -0.28 0.055" size="0.24 0.045 0.055" material="obstacle_red" friction="1 1 1"/>
    <geom name="center_block" type="box" pos="-0.75 0 0.08" size="0.16 0.16 0.08" material="obstacle_blue" friction="1 1 1"/>
    <geom name="offset_block_left" type="box" pos="-1.15 0.22 0.07" size="0.14 0.18 0.07" material="obstacle_blue" friction="1 1 1"/>
    <geom name="offset_block_right" type="box" pos="-1.55 -0.22 0.07" size="0.14 0.18 0.07" material="obstacle_blue" friction="1 1 1"/>
  </worldbody>

  <equality>
    <connect name="r1_hanging_connect" site1="world_hang_site" site2="pelvis_hang_site" active="true" solref="0.005 1"/>
  </equality>
</mujoco>
