<mujoco model="r1 scene">
  <compiler angle="radian" meshdir="assets"/>
  <include file="unitree_r1/xmls/r1.xml"/>

  <statistic center="0 0 5" extent="1"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="-130" elevation="-20"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3"
      markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>
  </asset>

  <default>
    <geom friction="0.9 0.005 0.0001" solimp="0.9 0.95 0.001" solref="0.002 1"/>
  </default>

  <worldbody>
    <light pos="0 0 1.5" dir="0 0 -1" directional="true"/>
    <geom name="floor" size="0 0 0.05" type="plane" material="groundplane" />
    
    <!-- Stool/Chair for sitting test: Height 48cm (z center 0.24, half-height 0.24), placed behind the robot -->
    <geom name="stool" pos="-0.33 0 0.24" size="0.18 0.18 0.24" type="box" rgba="0.7 0.4 0.25 1" friction="0.9 0.005 0.0001"/>

    
    <!-- Stairs (in front of the robot) -->
    <geom name="stair_1" pos="1.0 0 0.05" size="0.15 1.0 0.05" type="box" rgba="0.5 0.5 0.5 1"/>
    <geom name="stair_2" pos="1.3 0 0.1" size="0.15 1.0 0.1" type="box" rgba="0.6 0.6 0.6 1"/>
    <geom name="stair_3" pos="1.6 0 0.15" size="0.15 1.0 0.15" type="box" rgba="0.5 0.5 0.5 1"/>
    <geom name="stair_top" pos="2.5 0 0.2" size="0.75 1.0 0.2" type="box" rgba="0.6 0.6 0.6 1"/>
    <geom name="stair_down_1" pos="3.4 0 0.15" size="0.15 1.0 0.15" type="box" rgba="0.5 0.5 0.5 1"/>
    <geom name="stair_down_2" pos="3.7 0 0.1" size="0.15 1.0 0.1" type="box" rgba="0.6 0.6 0.6 1"/>
    <geom name="stair_down_3" pos="4.0 0 0.05" size="0.15 1.0 0.05" type="box" rgba="0.5 0.5 0.5 1"/>

    <!-- Uneven rough terrain (to the right of the robot) -->
    <geom name="rough_1" pos="0 -1.5 0.02" size="0.2 0.2 0.02" type="box" rgba="0.4 0.3 0.2 1"/>
    <geom name="rough_2" pos="0.5 -1.2 0.03" size="0.3 0.3 0.03" type="box" rgba="0.4 0.3 0.2 1"/>
    <geom name="rough_3" pos="-0.5 -1.7 0.04" size="0.25 0.25 0.04" type="box" rgba="0.4 0.3 0.2 1"/>
    <geom name="rough_4" pos="0.8 -1.6 0.025" size="0.2 0.4 0.025" type="box" rgba="0.4 0.3 0.2 1"/>
  </worldbody>

  <!-- Spawn ĐỨNG SẴN ở default pose, bàn chân vừa chạm sàn (pelvis z=0.734).
       Không có keyframe thì sim thả robot chân duỗi thẳng từ z=0.74 -> cú sốc
       tiếp đất ngẫu nhiên làm policy ngã vô cớ (xem PLAN_gesture_thang_bang.md 4c).
       qpos = free joint (3 pos + 4 quat) + 24 khớp theo thứ tự XML. -->
  <keyframe>
    <key name="stand"
         qpos="0 0 0.734 1 0 0 0
               -0.1 0 0 0.3 -0.2 0
               -0.1 0 0 0.3 -0.2 0
               0 0
               0.35 0.18 0 0.87 0
               0.35 -0.18 0 0.87 0"/>
  </keyframe>
</mujoco>
