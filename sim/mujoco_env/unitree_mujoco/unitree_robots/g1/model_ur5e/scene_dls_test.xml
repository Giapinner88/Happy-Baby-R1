<mujoco model="ur5e_pick_and_place_scene (torque)">
  <include file="ur5e_torque.xml"/>

  <statistic center="0.3 0 0.25" extent="1.2"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba fog="0.1 0.1 0.1 1"/>
    <global azimuth="120" elevation="-20"/>
  </visual>

  <asset>
    <texture name="texplane" type="2d" builtin="checker" rgb1="0.85 0.85 0.85" rgb2="0.75 0.75 0.75" width="512" height="512"/>
    <material name="matplane" reflectance="0.1" texture="texplane" texrepeat="10 10" texuniform="true"/>
    <!-- Sleek dark desk texture -->
    <texture name="textable" type="2d" builtin="flat" rgb1="0.12 0.14 0.16" width="512" height="512"/>
    <material name="mattable" texture="textable" reflectance="0.2" specular="0.5" shininess="0.5"/>
  </asset>

  <worldbody>
    <geom name="floor" pos="0 0 -0.6" size="0 0 1" type="plane" material="matplane" contype="1" conaffinity="1"/>
    <light name="spotlight" mode="targetbodycom" target="table" pos="0 -1 1.4"/>

    <!-- Table top is at z=0, matching the UR5e base origin in ur5e_torque.xml. 
         Expanded size and position so the robot base (0,0) sits on it. -->
    <body name="table" pos="0.25 0 -0.3">
      <geom name="table_top" type="box" size="0.6 0.8 0.3" material="mattable" contype="1" conaffinity="1" group="2"/>
    </body>

    <!-- Drop bin -->
    <body name="bin" pos="0.25 0.50 0.00">
      <geom name="box_bottom" type="box" size="0.12 0.12 0.01" pos="0 0 0" rgba="0.7 0.7 0.7 1"/>
      <geom name="box_wall1" type="box" size="0.01 0.12 0.06" pos="0.12 0 0.05" rgba="0.7 0.7 0.7 0.6"/>
      <geom name="box_wall2" type="box" size="0.01 0.12 0.06" pos="-0.12 0 0.05" rgba="0.7 0.7 0.7 0.6"/>
      <geom name="box_wall3" type="box" size="0.12 0.01 0.06" pos="0 0.12 0.05" rgba="0.7 0.7 0.7 0.6"/>
      <geom name="box_wall4" type="box" size="0.12 0.01 0.06" pos="0 -0.12 0.05" rgba="0.7 0.7 0.7 0.6"/>
    </body>

    <!-- Pick objects -->
    <body name="target_box" pos="0.70 0.55 0.0375">
      <joint type="free"/>
      <geom type="box" size="0.0375 0.0375 0.0375" rgba="0.9 0.1 0.1 1" mass="0.15" friction="1 0.005 0.0001"/>
    </body>

    <body name="target_cylinder" pos="0.15 0.20 0.0375">
      <joint type="free"/>
      <geom type="box" size="0.0375 0.0375 0.0375" rgba="0.1 0.8 0.1 1" mass="0.15" friction="1 0.005 0.0001"/>
    </body>

    <body name="target_cube3" pos="0.50 -0.20 0.0375">
      <joint type="free"/>
      <geom type="box" size="0.0375 0.0375 0.0375" rgba="0.5 0.1 0.8 1" mass="0.15" friction="1 0.005 0.0001"/>
    </body>
  </worldbody>

  <keyframe>
    <key name="home"
      qpos="-1.5708 -1.5708 1.5708 -1.5708 -1.5708 0 0 0 0.70 0.55 0.0375 1 0 0 0 0.15 0.20 0.0375 1 0 0 0 0.50 -0.20 0.0375 1 0 0 0"
      ctrl="0 0 0 0 0 0 0.0"/>
  </keyframe>
</mujoco>
