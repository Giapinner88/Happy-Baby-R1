<mujoco model="ur5e_pick_and_place_scene">
  <include file="ur5e.xml"/>

  <statistic center="0.3 0 0.25" extent="1.2"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba fog="0.1 0.1 0.1 1"/>
    <global azimuth="120" elevation="-20"/>
  </visual>

  <asset>
    <texture name="texplane" type="2d" builtin="checker" rgb1=".2 .3 .4" rgb2=".1 .2 .3" width="512" height="512"/>
    <material name="matplane" reflectance="0.3" texture="texplane" texrepeat="5 5" texuniform="true"/>
    <texture name="texwood" type="2d" builtin="flat" rgb1="0.6 0.4 0.2" width="512" height="512"/>
    <material name="matwood" texture="texwood" reflectance="0.1"/>
  </asset>

  <worldbody>
    <geom name="floor" pos="0 0 -0.6" size="0 0 1" type="plane" material="matplane" contype="1" conaffinity="1"/>
    <light name="spotlight" mode="targetbodycom" target="table" pos="0 -1 1.4"/>

    <!-- Table top is at z=0, matching the UR5e base origin in ur5e.xml. -->
    <body name="table" pos="0.5 0 -0.3">
      <geom name="table_top" type="box" size="0.4 0.6 0.3" material="matwood" contype="1" conaffinity="1" group="2"/>
    </body>

    <!-- Drop bin -->
    <body name="bin" pos="0.25 0.50 0.00">
      <geom name="box_bottom" type="box" size="0.12 0.12 0.01" pos="0 0 0" rgba="0.7 0.7 0.7 1"/>
      <geom name="box_wall1" type="box" size="0.01 0.12 0.06" pos="0.12 0 0.05" rgba="0.7 0.7 0.7 0.6"/>
      <geom name="box_wall2" type="box" size="0.01 0.12 0.06" pos="-0.12 0 0.05" rgba="0.7 0.7 0.7 0.6"/>
      <geom name="box_wall3" type="box" size="0.12 0.01 0.06" pos="0 0.12 0.05" rgba="0.7 0.7 0.7 0.6"/>
      <geom name="box_wall4" type="box" size="0.12 0.01 0.06" pos="0 -0.12 0.05" rgba="0.7 0.7 0.7 0.6"/>
    </body>

    <!-- Pick objects -->
    <body name="target_box" pos="0.50 0.15 0.025">
      <joint type="free"/>
      <geom type="box" size="0.025 0.025 0.025" rgba="0.9 0.1 0.1 1" mass="0.15" friction="1 0.005 0.0001"/>
    </body>

    <body name="target_cylinder" pos="0.55 -0.15 0.025">
      <joint type="free"/>
      <geom type="box" size="0.025 0.025 0.025" rgba="0.1 0.8 0.1 1" mass="0.15" friction="1 0.005 0.0001"/>
    </body>

    <body name="target_cube3" pos="0.55 -0.30 0.025">
      <joint type="free"/>
      <geom type="box" size="0.025 0.025 0.025" rgba="0.5 0.1 0.8 1" mass="0.15" friction="1 0.005 0.0001"/>
    </body>
  </worldbody>

  <keyframe>
    <key name="home"
      qpos="-1.5708 -1.5708 1.5708 -1.5708 -1.5708 0 0 0 0.50 0.15 0.025 1 0 0 0 0.55 -0.15 0.025 1 0 0 0 0.55 -0.30 0.025 1 0 0 0"
      ctrl="-1.5708 -1.5708 1.5708 -1.5708 -1.5708 0 0"/>
  </keyframe>
</mujoco>
